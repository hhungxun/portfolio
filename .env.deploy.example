# Public URL used for canonical links, the sitemap, and RSS.
SITE_URL=https://hhungxun.my

# SSH connection to the Hostinger VPS.
DEPLOY_HOST=203.0.113.10
DEPLOY_PORT=22
DEPLOY_USER=deploy
# Optional: uncomment when the key is not loaded in ssh-agent.
