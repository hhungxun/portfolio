---
import Base from '../../../layouts/Base.astro';
import { getPosts, allTags, tagSlug } from '../../../lib/content';

const posts = await getPosts();
const tags = allTags(posts);
---

<Base side="both" title="Tags" description="Every tag used across the blog.">
  <p class="label">Blog</p>
  <h1 class="mt-1 text-[2rem] font-medium tracking-tight">Tags</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    {tags.length} tags across {posts.length} {posts.length === 1 ? 'post' : 'posts'}.
  </p>

  <ul class="mt-8 flex flex-wrap gap-2">
    {
      tags.map(({ tag, count }) => (
        <li>
          <a
            href={`/blog/tags/${tagSlug(tag)}`}
            class="inline-flex items-baseline gap-1.5 rounded-full border border-line px-3 py-1 text-[0.85rem] text-ink-2 no-underline transition-colors hover:border-accent hover:text-accent"
          >
            {tag}
            {/* A count of one is true of almost every tag here, so printing it
                adds a column of 1s and no information. */}
            {count > 1 && <span class="text-[0.7em] text-muted">{count}</span>}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-12 text-[0.9rem]">
    <a href="/blog" class="text-accent no-underline hover:underline">← All posts</a>
  </p>
</Base>
