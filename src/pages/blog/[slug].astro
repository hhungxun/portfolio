---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import { getPosts, formatDate, readingTime, tagSlug } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, lang, side, sample, translation } = post.data;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
const headerSide = side === 'physics' ? 'physics' : side === 'poetry' ? 'poetry' : 'both';
const adjacentOlder = older?.id === translation?.slug ? null : older;
const adjacentNewer = newer?.id === translation?.slug ? null : newer;
---

<Base side={headerSide} lang={lang} title={title} description={description}>
  <article>
    <header class="max-w-2xl">
      {
        sample && (
          <p class="mb-3 text-[0.75rem] uppercase tracking-wider text-muted">
            Sample post shipped with the site scaffold. Delete or replace it.
          </p>
        )
      }
      <h1 class:list={['text-[2rem] sm:text-[2.3rem] font-medium leading-tight tracking-tight text-balance', lang === 'zh' && 'font-tc tracking-[0.03em]']}>
        {title}
      </h1>
      {description && <p class:list={['mt-3 text-[1.1rem] text-ink-2', lang === 'zh' && 'font-tc']}>{description}</p>}
      {translation && <LanguageToggle current={lang} alternate={translation} />}
      <p class="mt-4 text-[0.85rem] text-muted flex flex-wrap gap-x-3 gap-y-1">
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        {updated && <span>updated {formatDate(updated, lang)}</span>}
        <span>{minutes} min read</span>
        {
          tags.map((t) => (
            <a href={`/blog/tags/${tagSlug(t)}`} class="no-underline hover:text-accent">
              #{t}
            </a>
          ))
        }
      </p>
    </header>

    <div class="prose mt-10" lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
      <Content />
    </div>

    {(adjacentOlder || adjacentNewer) && <nav class="mt-16 pt-6 border-t border-line flex justify-between gap-6 text-[0.9rem]" aria-label="Post navigation">
      <span>
        {
          adjacentOlder && (
            <a href={`/blog/${adjacentOlder.id}`} class="no-underline text-ink-2 hover:text-accent">
              ← {adjacentOlder.data.title}
            </a>
          )
        }
      </span>
      <span class="text-right">
        {
          adjacentNewer && (
            <a href={`/blog/${adjacentNewer.id}`} class="no-underline text-ink-2 hover:text-accent">
              {adjacentNewer.data.title} →
            </a>
          )
        }
      </span>
    </nav>}
  </article>
</Base>
