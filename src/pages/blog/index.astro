---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, allTags, tagSlug } from '../../lib/content';

const posts = await getPosts();
const tags = allTags(posts);
---

<Base side="both" title="Blog" description="Notes on physics, poetics, and whatever sits between them.">
  <h1 class="text-[2rem] font-medium tracking-tight">Blog</h1>
  <p class="mt-3 text-ink-2">Notes on physics, on poems, and on whatever sits between them. Posts are in English or Chinese, whichever fits.</p>

  {
    tags.length > 0 && (
      <p class="mt-5 flex flex-wrap gap-x-3 gap-y-1 text-[0.85rem]">
        {tags.map(({ tag, count }) => (
          <a href={`/blog/tags/${tagSlug(tag)}`} class="text-muted no-underline hover:text-accent">
            #{tag} <span class="text-[0.75em] align-middle">{count}</span>
          </a>
        ))}
      </p>
    )
  }

  <div class="mt-10 space-y-8">
    {posts.map((post) => <PostCard post={post} />)}
    {posts.length === 0 && <p class="text-muted">Nothing here yet.</p>}
  </div>

  <p class="mt-12 text-[0.85rem] text-muted">
    Subscribe via <a href="/rss.xml" class="text-accent no-underline hover:underline">RSS</a>.
  </p>
</Base>
