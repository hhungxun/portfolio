---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, allTags } from '../../lib/content';

const allPosts = await getPosts();
// A translated edition is an alternate view of one article, not a second
// entry in the index. Prefer the English edition when both are published.
const posts = allPosts.filter((post) => {
  const alternate = post.data.translation;
  if (!alternate) return true;
  const companion = allPosts.find((candidate) => candidate.id === alternate.slug);
  return post.data.lang === 'en' || !companion || companion.data.lang !== 'en';
});
const tagCount = allTags(posts).length;
---

<Base side="both" title="Blog" description="Notes on physics, poetics, and whatever sits between them.">
  <h1 class="text-[2rem] font-medium tracking-tight">Blog</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    Notes on physics, on poems, and on whatever sits between them. Posts are in English or Chinese,
    whichever fits.
  </p>

  <ol class="mt-10 space-y-9">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
    {posts.length === 0 && <li class="text-muted">Nothing here yet.</li>}
  </ol>

  <p class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.85rem] text-muted">
    <a href="/blog/tags" class="no-underline hover:text-accent">Browse {tagCount} tags</a>
    <a href="/rss.xml" class="no-underline hover:text-accent">Subscribe via RSS</a>
  </p>
</Base>
