---
import Base from '../layouts/Base.astro';
---

<Base side="both" title="Not found">
  <p class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">404</p>
  <h1 class="mt-2 text-[2rem] font-medium tracking-tight">Nothing at this address.</h1>
  <p class="mt-3 text-ink-2 font-tc" lang="zh-Hant">此頁不存在。</p>
  <p class="mt-6">
    <a href="/" class="text-accent no-underline hover:underline">← Home</a>
  </p>
</Base>
