---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import QuantumWalk from '../components/QuantumWalk.tsx';
import { site } from '../data/site';
import { cv } from '../data/cv';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<Base side="physics" title="Physics" description={site.physicsBioEn}>
  <h1 class="text-[2rem] font-medium tracking-tight">Physics</h1>
  <p class="mt-4 text-[1.1rem] text-ink-2 leading-relaxed max-w-2xl">{site.physicsBioEn}</p>
  <p class="mt-3 text-[0.9rem] text-muted">
    <a href="/cv" class="text-accent no-underline hover:underline">Full CV</a> ·
    <a href={cv.pdf} class="text-accent no-underline hover:underline">CV as PDF</a> ·
    <a href={site.github} class="text-accent no-underline hover:underline">GitHub</a>
  </p>

  <section class="mt-12" aria-label="Quantum walk animation">
    <QuantumWalk client:visible steps={40} height={210} caption="A Hadamard quantum walk spreads ballistically, σ ∝ t, while a classical random walk diffuses, σ ∝ √t. From my project on quantum random walks." />
  </section>

  <section class="mt-12">
    <h2 class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">Projects &amp; write-ups</h2>
    <div class="mt-2">
      {projects.map((p) => <ProjectCard project={p} full />)}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">Current directions</h2>
    <ul class="mt-4 space-y-5">
      {
        cv.directions.map((d) => (
          <li>
            <h3 class="font-medium">{d.title}</h3>
            <p class="text-ink-2 mt-1">{d.text}</p>
            {'links' in d && d.links && (
              <p class="mt-1 text-[0.85rem] flex flex-wrap gap-x-3">
                {d.links.map((l) => (
                  <a href={l.href} class="text-accent no-underline hover:underline font-mono">
                    {l.label}
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">Community &amp; talks</h2>
    <ul class="mt-4 space-y-5">
      {
        cv.activities.map((a) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-medium">{a.role}</h3>
              <span class="text-[0.82rem] text-muted font-mono">{a.period}</span>
            </div>
            <p class="text-ink-2 mt-1">{a.text}</p>
            {a.bullets.length > 0 && (
              <ul class="mt-2 list-disc pl-5 text-ink-2 space-y-1">
                {a.bullets.map((b) => (
                  <li set:html={b.replace(/\*(.+?)\*/g, '<em>$1</em>')} />
                ))}
              </ul>
            )}
            {a.links.length > 0 && (
              <p class="mt-2 text-[0.85rem] flex flex-wrap gap-x-3">
                {a.links.map((l) => (
                  <a href={l.href} class="text-accent no-underline hover:underline">
                    {l.label} ↗
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
