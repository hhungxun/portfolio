---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import QuantumWalk from '../components/QuantumWalk.tsx';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';
import { cv } from '../data/cv';
import { getPosts, getProjects } from '../lib/content';

const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
const physicsPosts = posts.filter((post) => post.data.side === 'physics' && !post.data.sample);
const linkedNotes = new Set(projects.map((project) => project.data.note).filter(Boolean));
for (const id of linkedNotes) {
  if (!physicsPosts.some((post) => post.id === id)) throw new Error(`Missing published physics note: ${id}`);
}
const otherNotes = physicsPosts.filter((post) => !linkedNotes.has(post.id));
---

<Base side="physics" title="Physics" description={site.physicsBioEn}>
  <h1 class="text-[2rem] font-medium tracking-tight">Physics</h1>
  <p class="mt-4 text-[1.1rem] text-ink-2 leading-relaxed max-w-2xl">{site.physicsBioEn}</p>
  <p class="mt-3 text-[0.9rem] text-muted">
    <a href="/cv" class="text-accent no-underline hover:underline">Full CV</a> ·
    <a href={cv.pdf} class="text-accent no-underline hover:underline">CV as PDF</a> ·
    <a href={site.github} class="text-accent no-underline hover:underline">GitHub</a>
  </p>

  <section class="mt-12" aria-label="Quantum walk animation">
    <QuantumWalk client:visible steps={40} height={210} caption="A Hadamard quantum walk spreads ballistically, σ ∝ t, while a classical random walk diffuses, σ ∝ √t. From my project on quantum random walks." />
  </section>

  <section class="mt-12">
    <h2 class="label">Projects &amp; research notes</h2>
    <p class="mt-3 text-ink-2">Each project brings together an explanation, the technical paper, and its source repository.</p>
    <div class="mt-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="label">Mathematical toolkit</h2>
    <p class="mt-4 text-ink-2 leading-relaxed max-w-3xl">
      Eigenvalue localisation (Gershgorin and Cassini) · symplectic and covariance-matrix methods · Floquet
      theory · Hamilton–Jacobi and Madelung formulations · principal and frame bundles · holonomy · Lie
      groups · spherical harmonics · singular perturbation theory · real and quaternionic Hilbert spaces.
    </p>
  </section>

  {otherNotes.length > 0 && <section class="mt-12">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="label">Further reading</h2>
      <a href="https://github.com/hhungxun/physics-writeups" class="text-[0.85rem] text-accent no-underline hover:underline">
        PDF write-ups repository ↗
      </a>
    </div>
    <div class="mt-5 space-y-8">
      {otherNotes.map((post) => <PostCard post={post} as="h3" />)}
    </div>
  </section>}
</Base>
