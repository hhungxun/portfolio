---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';
const em = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

<Base side="physics" title="CV" description={cv.summary}>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="text-[2rem] font-medium tracking-tight">Curriculum Vitae</h1>
    <p class="text-[0.9rem] flex gap-x-4">
      <a href={cv.pdf} class="text-accent no-underline hover:underline">Download PDF ↓</a>
      <span class="text-muted font-mono">updated {cv.updated}</span>
    </p>
  </div>
  <p class="mt-2 text-[0.9rem] text-muted">
    {cv.affiliation} · <a href={`mailto:${cv.email}`} class="hover:text-accent">{cv.email}</a> ·
    <a href={cv.github} class="hover:text-accent">GitHub</a>
  </p>

  <section class="mt-10">
    <h2 class="cv-h">Summary</h2>
    <p class="mt-3 text-ink-2 leading-relaxed">{cv.summary}</p>
  </section>

  <section class="mt-10">
    <h2 class="cv-h">Research &amp; technical projects</h2>
    <div class="mt-3 space-y-6">
      {
        cv.projects.map((p) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-medium">
                {p.link ? <a href={p.link} class="no-underline text-ink hover:text-accent">{p.title}</a> : p.title}
              </h3>
              <span class="text-[0.82rem] text-muted font-mono">{p.period}</span>
            </div>
            <ul class="mt-1.5 list-disc pl-5 text-ink-2 space-y-1 text-[0.97rem]">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="cv-h">Current research directions &amp; training</h2>
    <ul class="mt-3 list-disc pl-5 text-ink-2 space-y-2 text-[0.97rem]">
      {
        cv.directions.map((d) => (
          <li>
            <strong class="text-ink font-medium">{d.title}:</strong> {d.text}
            {'links' in d && d.links && (
              <span class="ml-1">
                [
                {d.links.map((l, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={l.href} class="text-accent no-underline hover:underline font-mono text-[0.9em]">
                      {l.label}
                    </a>
                  </>
                ))}
                ]
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="cv-h">Education</h2>
    {
      cv.education.map((e) => (
        <div class="mt-3 grid sm:grid-cols-[9rem_1fr] gap-x-6 gap-y-1">
          <span class="text-[0.85rem] text-muted font-mono">{e.period}</span>
          <div>
            <p>
              <strong class="font-medium">{e.degree}</strong>, {e.institution}
            </p>
            <p class="text-ink-2 text-[0.95rem]">{e.details}</p>
            <p class="text-ink-2 text-[0.95rem] mt-1">
              <em>Selected coursework:</em> {e.coursework}
            </p>
          </div>
        </div>
      ))
    }
  </section>

  <section class="mt-10">
    <h2 class="cv-h">Leadership &amp; activities</h2>
    <div class="mt-3 space-y-5">
      {
        cv.activities.map((a) => (
          <div class="grid sm:grid-cols-[9rem_1fr] gap-x-6 gap-y-1">
            <span class="text-[0.85rem] text-muted font-mono">{a.period}</span>
            <div>
              <p>
                <strong class="font-medium">{a.role}</strong> — {a.text}
              </p>
              {a.bullets.length > 0 && (
                <ul class="mt-1.5 list-disc pl-5 text-ink-2 space-y-1 text-[0.95rem]">
                  {a.bullets.map((b) => (
                    <li set:html={em(b)} />
                  ))}
                </ul>
              )}
              {a.links.length > 0 && (
                <p class="mt-1 text-[0.85rem] flex flex-wrap gap-x-3">
                  {a.links.map((l) => (
                    <a href={l.href} class="text-accent no-underline hover:underline">
                      {l.label} ↗
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="cv-h">Skills</h2>
    <dl class="mt-3 grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-3 text-[0.95rem]">
      {
        cv.skills.map((s) => (
          <>
            <dt class="font-medium">{s.area}</dt>
            <dd class="text-ink-2">{s.text}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .cv-h {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
</style>
