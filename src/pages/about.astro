---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base side="both" title="About" description={site.description}>
  <h1 class="text-[2rem] font-medium tracking-tight">About</h1>

  <div class="mt-8 grid gap-10 sm:grid-cols-[1fr_1fr]">
    <section>
      <h2 class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">As a physicist</h2>
      <p class="mt-3 text-ink-2 leading-relaxed">{site.physicsBioEn}</p>
      <p class="mt-3 text-ink-2 leading-relaxed">
        Outside coursework I serve as Vice President of the Physics Student Council and the Astronomy Club, and I
        founded the department’s <a href={site.physicsForum} class="text-accent">Physics Forum</a>, a student journal club.
      </p>
      <p class="mt-4 text-[0.9rem]">
        <a href="/physics" class="text-accent no-underline hover:underline">Projects →</a>
        <span class="text-muted mx-2">·</span>
        <a href="/cv" class="text-accent no-underline hover:underline">CV →</a>
      </p>
    </section>

    <section>
      <h2 class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">As a poet <span class="font-tc text-[1rem] ml-1">連宏勛</span></h2>
      <p class="mt-3 text-ink-2 leading-relaxed">{site.poetBioEn}</p>
      <p class="mt-3 text-ink-2 leading-relaxed font-tc" lang="zh-Hant">{site.poetBioZh}</p>
      <p class="mt-4 text-[0.9rem]">
        <a href="/poetry" class="text-accent no-underline hover:underline">Poems →</a>
      </p>
    </section>
  </div>

  <section class="mt-14">
    <h2 class="text-[0.8rem] uppercase tracking-[0.18em] text-muted">Contact</h2>
    <p class="mt-3 text-ink-2">
      Email <a href={`mailto:${site.email}`} class="text-accent">{site.email}</a> or find me on
      <a href={site.github} class="text-accent">GitHub</a>.
    </p>
  </section>

  <section class="mt-14 text-[0.85rem] text-muted leading-relaxed">
    <h2 class="text-[0.8rem] uppercase tracking-[0.18em]">Colophon</h2>
    <p class="mt-2">
      Built with Astro and React, typeset in Newsreader, Noto Serif TC, and JetBrains Mono. Math by KaTeX; Traditional
      to Simplified conversion by OpenCC. Poems are stored in Traditional Chinese and were first published in Simplified
      Chinese by <span class="font-tc">星洲日報</span>.
    </p>
  </section>
</Base>
