---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="w-full max-w-3xl mx-auto px-5 sm:px-8 pb-10 pt-8 mt-8 border-t border-line text-[0.85rem] text-muted">
  <div class="flex flex-wrap justify-between gap-x-6 gap-y-2">
    <p>
      © {year} {site.nameEn} <span class="font-tc">連宏勛</span>
    </p>
    <p class="flex gap-x-4">
      <a href={site.github} class="hover:text-accent no-underline" rel="me">GitHub</a>
      <a href={`mailto:${site.email}`} class="hover:text-accent no-underline">Email</a>
      <a href="/rss.xml" class="hover:text-accent no-underline">RSS</a>
    </p>
  </div>
</footer>
