---
/**
 * 倉鼠 — the site's small resident. Drawn as strokes rather than fills so it
 * reads as a doodle and picks up `currentColor` in both themes.
 *
 * Deliberately unnamed and unexplained on the page: there is a hamster elegy
 * in the poems, and this doodle should not make a joke of it.
 */
interface Props {
  size?: number;
  class?: string;
  /** show the sunflower seed it is holding */
  seed?: boolean;
}
const { size = 56, class: className, seed = true } = Astro.props;
---

<svg
  width={size}
  height={(size * 46) / 62}
  viewBox="0 0 62 46"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="A doodled hamster"
>
  <title>倉鼠</title>
  <!-- body: one loose, slightly lopsided outline -->
  <path
    d="M12 34 C 5 30, 4 20, 11 14 C 17 8.5, 27 6, 36 7.5 C 46 9, 55 15, 56 24 C 57 32, 50 38, 40 39 C 30 40, 18 39, 12 34 Z"
  />
  <!-- ears -->
  <path d="M17 11 C 14 6, 17 3, 21 5.5 C 23 6.8, 23.6 9, 23 11" />
  <path d="M36 7.6 C 35 3.2, 38.6 1.4, 41.6 4.2 C 43.2 5.7, 43.4 8, 42.6 9.8" />
  <!-- eye and cheek -->
  <path d="M19.5 21 C 19.5 19.6, 21.6 19.6, 21.6 21 C 21.6 22.4, 19.5 22.4, 19.5 21 Z" fill="currentColor" />
  <path d="M14.5 26.5 C 16.6 25.2, 19 25.4, 20.6 27" />
  <!-- nose and mouth -->
  <path d="M10.6 23.4 C 9.4 23.4, 9 24.8, 10.2 25.2" />
  <path d="M10.4 25.4 C 10.4 27.2, 12.4 27.8, 13.6 26.8" />
  <!-- whiskers -->
  <path d="M9 21.6 L 3 19.4" opacity="0.75" />
  <path d="M8.6 27.6 L 2.4 28.6" opacity="0.75" />
  <!-- feet -->
  <path d="M22 39 C 21 42.4, 23.4 44, 25.6 42.6" />
  <path d="M38 38.6 C 37.4 42, 39.8 43.6, 42 42.2" />
  <!-- tail, such as it is -->
  <path d="M55.6 27.4 C 59.6 26.6, 60.6 30.4, 57.6 31.4" />
  {
    seed && (
      <g>
        <path d="M25.4 31.6 C 27.4 29.6, 30.6 29.6, 32.2 31.8 C 33.4 33.6, 31.6 36, 28.8 36 C 26.2 36, 24.4 33.4, 25.4 31.6 Z" />
        <path d="M27 32.6 L 30.6 34.4" opacity="0.7" />
      </g>
    )
  }
</svg>
