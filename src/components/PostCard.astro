---
import type { Post } from '../lib/content';
import { formatDate, readingTime, tagSlug } from '../lib/content';

interface Props {
  post: Post;
  showTags?: boolean;
  /** Heading level for the title. Pages that list posts under an <h2> section
   *  label pass "h3" so the document outline stays in order. */
  as?: 'h2' | 'h3';
}
const { post, showTags = true, as = 'h2' } = Astro.props;
const { title, description, date, tags, lang, sample } = post.data;
const minutes = readingTime(post.body ?? '');
const Heading = as;
const zh = lang === 'zh';
---

<article class="group">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.78rem] text-muted">
    <time datetime={date.toISOString()}>{formatDate(date, 'en')}</time>
    <span aria-hidden="true" class="opacity-50">·</span>
    <span>{minutes} min</span>
    {
      showTags &&
        tags.map((t) => (
          <>
            <span aria-hidden="true" class="opacity-50">·</span>
            <a href={`/blog/tags/${tagSlug(t)}`} class="no-underline hover:text-accent">
              {t}
            </a>
          </>
        ))
    }
    {
      sample && (
        <span class="rounded border border-line px-1.5 py-0.5 text-[0.7rem] uppercase tracking-wider">
          sample
        </span>
      )
    }
  </p>

  <Heading class="mt-1 text-[1.15rem] font-medium leading-snug">
    <a
      href={`/blog/${post.id}`}
      class:list={['no-underline text-ink group-hover:text-accent transition-colors', zh && 'font-tc']}
      lang={zh ? 'zh-Hant' : undefined}
    >
      {title}
    </a>
  </Heading>

  {
    description && (
      <p
        class:list={['mt-1.5 max-w-[68ch] text-ink-2', zh && 'font-tc']}
        lang={zh ? 'zh-Hant' : undefined}
      >
        {description}
      </p>
    )
  }

</article>
